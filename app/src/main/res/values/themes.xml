<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Nexus.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/nexus_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/transparent_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Nexus.Main</item>
        <item name="android:statusBarColor">@color/nexus_bg</item>
        <item name="android:navigationBarColor">@color/nexus_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.Nexus.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/nexus_bg</item>
        <item name="android:statusBarColor">@color/nexus_bg</item>
        <item name="android:navigationBarColor">@color/nexus_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
